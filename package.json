{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm --workspace @phishguard/sandbox-service run build",
    "start": "next start",
    "lint": "eslint && npm --workspace @phishguard/sandbox-service run lint",
    "test": "vitest run && npm --workspace @phishguard/sandbox-service test",
    "test:sandbox:e2e": "npm --workspace @phishguard/sandbox-service run test:e2e"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "vitest": "^3.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "workspaces": [
    "sandbox"
  ]
}
