# Vintage Magic Beirut - every variable this app reads. All are optional; nothing here is a secret
# the repository should contain, and .env.local is gitignored. Copy to .env.local.

# --------------------------------------------------------------------------- data
# With BOTH of these set, the shop reads and writes Supabase Postgres (apply
# supabase/schema.sql first). With either missing it uses the file store in data/db.json.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  # server-side only. Never expose it, never alias it to NEXT_PUBLIC_*.
#
# Force the file store even when Supabase credentials are present (tests, demos, offline work).
# VINTAGE_FORCE_LOCAL_DATA=1
#
# Where the file store keeps its data. Defaults to ./data/db.json relative to vintage-magic/.
# VINTAGE_LOCAL_DB=/absolute/path/to/db.json
#
# Hide the "sample stock" notice once you have loaded real pieces. off | 1
# VINTAGE_SAMPLE_MODE=off

# ------------------------------------------------------------------------ uploads
# Storage bucket for product images, when Supabase is configured. Default: product-images
# SUPABASE_IMAGE_BUCKET=product-images

# -------------------------------------------------------------------------- admin
# Both are needed to open /admin. Without ADMIN_PASSWORD the panel refuses to start and says why;
# it never falls back to a default password. ADMIN_SESSION_SECRET signs the admin cookie and must be
# long and random, e.g. `openssl rand -hex 32`. In development the secret may be omitted and a
# per-process one is generated; in production it is required.
# ADMIN_PASSWORD=change-me-to-something-unguessable
# ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------- shop settings
# Courier fees, in USD cents. Unset means the defaults in src/lib/config.ts ($5 Beirut, $10 elsewhere
# in Lebanon). There is no card payment in this app: orders are settled in cash on collection or
# delivery, and the checkout says so.
# VINTAGE_COURIER_BEIRUT_CENTS=500
# VINTAGE_COURIER_LEBANON_CENTS=1000

# ------------------------------------------------------------- contact (fallbacks)
# Seed values for store content, editable in /admin/content. The database wins once saved.
# Anything left unset is reported as "not configured" - the site never invents a phone number,
# an address, an opening hour or a social account.
# VINTAGE_CONTACT_PHONE=
# VINTAGE_CONTACT_EMAIL=
# VINTAGE_CONTACT_INSTAGRAM=
# VINTAGE_CONTACT_WHATSAPP=
# VINTAGE_ADDRESS=
# VINTAGE_HOURS=

# --------------------------------------------------------------------------- port
# npm run dev / start bind 0.0.0.0:3005 so the app is reachable outside the container.
# Change it in package.json scripts if that port is taken.
